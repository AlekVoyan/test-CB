# Copy to .env and fill in. Never commit .env.

# Which model provider answers questions: "anthropic" (target, Claude Haiku 4.5) or "nvidia" (free hosted open model)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# Only needed when LLM_PROVIDER=nvidia (key from build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Neural voice (optional). Without a key the browser's own voice speaks. Give the key only "Text to Speech"
# access and a credit limit; it stays on the server.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX

# full = whole corpus in the prompt (default, corpus is <= 10 pages); topk = BM25 top-k paragraphs
RETRIEVAL_MODE=full
EVIDENCE_TOKEN_BUDGET=8000
# how many times `npm run eval` repeats every session
EVAL_RUNS=3
