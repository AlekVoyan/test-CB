# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
# full = whole corpus in the prompt (default, corpus is <= 10 pages); topk = BM25 top-k paragraphs
RETRIEVAL_MODE=full
EVIDENCE_TOKEN_BUDGET=8000
# how many times `npm run eval` repeats every session
EVAL_RUNS=3
